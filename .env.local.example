# Supabase — Project Settings → API. Both are safe in the browser bundle.
# Leave these unset and U still runs, on the seeded multiverse in src/lib/soul.ts.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Voice calls. STUN alone connects people on ordinary home wifi; a TURN relay is
# what makes calls work on mobile data, campus and office networks. Without it,
# those calls fail with "connecting" then "could not connect".
# Cloudflare Realtime (free allowance) or Metered both hand you these three values.
# NEXT_PUBLIC_TURN_URL=turn:your-relay:3478,turns:your-relay:5349?transport=tcp
# NEXT_PUBLIC_TURN_USER=your-username
# NEXT_PUBLIC_TURN_PASS=your-credential
